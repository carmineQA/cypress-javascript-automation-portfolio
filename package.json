{
  "name": "cypress-javascript-automation-portfolio",
  "version": "1.0.0",
  "description": "Cypress + JavaScript test automation portfolio, companion to the Playwright and Selenium projects, demonstrating idiomatic Cypress patterns (custom commands, cy.intercept network mocking) rather than a 1:1 port of the Page Object Model.",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:smoke": "cypress run --expose grepTags=@smoke",
    "test:regression": "cypress run --expose grepTags=@regression",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cypress/grep": "^6.0.2",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "cypress": "^15.19.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.3",
    "prettier": "^3.9.6"
  }
}
